rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace these two placeholders during provisioning
    // (docs/PROVISIONING.md) with the real Firebase Auth UIDs.
    function isPartnerA() {
      return request.auth != null
        && request.auth.uid == 'mzNOSMi0bgU5QNzyy29UKBEyOhX2';
    }
    function isPartnerB() {
      return request.auth != null
        && request.auth.uid == 'SkZx6Wh7cFVj1XuDdM4WIlx3JxB2';
    }
    function isAllowed() { return isPartnerA() || isPartnerB(); }
    function isCoupleMember(coupleId) {
      return isAllowed()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberUids;
    }

    match /users/{uid} {
      allow read: if isAllowed() && request.auth.uid == uid;
      // A partner may read the other partner's profile (needed for
      // HomeScreen / Love tab), but never write it.
      allow read: if isAllowed();
      allow write: if request.auth != null && request.auth.uid == uid
        && isAllowed();
    }

    match /couples/{coupleId} {
      allow read, write: if isCoupleMember(coupleId);
    }

    match /conversations/{conversationId} {
      allow read, write: if isAllowed()
        && resource.data.memberUids != null
        && request.auth.uid in resource.data.memberUids;
      allow create: if isAllowed()
        && request.resource.data.memberUids != null
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.senderUid == request.auth.uid;
      // Only the sender may edit/delete their own message.
      allow update, delete: if isAllowed()
        && resource.data.senderUid == request.auth.uid;
    }

    match /couples/{coupleId}/chat/{docId} {
      allow read, write: if isCoupleMember(coupleId);
    }

    match /romantic_events/{eventId} {
      allow read: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /surprises/{surpriseId} {
      // Sealed surprises: ciphertext only, never plaintext.
      // Unlock is enforced by the revealSurprise Cloud Function —
      // clients may NOT set `revealed: true` themselves.
      allow read: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.sealed == true;
      allow update: if false;
      allow delete: if isAllowed()
        && resource.data.senderUid == request.auth.uid;
    }

    match /call_sessions/{sessionId} {
      allow read: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.callerUid == request.auth.uid;
      allow update: if isAllowed();
      allow delete: if false;
    }

    match /device_tokens/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid && isAllowed();
    }

    match /widget_preferences/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid && isAllowed();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
