rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only the two provisioned UIDs, under their couple folder.
    // File names / paths never grant access to a third user.
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == 'mzNOSMi0bgU5QNzyy29UKBEyOhX2'
          || request.auth.uid == 'SkZx6Wh7cFVj1XuDdM4WIlx3JxB2');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
